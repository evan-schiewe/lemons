{
  "name": "lemons-race-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13 <25",
    "pnpm": "11.3.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit",
    "check:write": "biome check --write . && tsc --noEmit"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/sql.js": "1.4.11",
    "rollup-plugin-visualizer": "7.0.1",
    "typescript": "6.0.3",
    "vite": "8.0.14"
  }
}
